# Copy to .env and fill in.

# Whichever Plex account this token belongs to is whose play state (viewCount,
# lastViewedAt) controls deletion -- see PLEX_TOKEN in the README.
#
# Finding your OWN token:
#   https://support.plex.tv/articles/204059436-finding-an-authentication-token-x-plex-token/
#
# Minting a token for a specific PLEX HOME USER (not the server owner) --
# there's no simple lookup for this in Plex itself:
#   https://github.com/claude-on-call/music-library-tools -> plex-home-tokens.py
#   python3 plex-home-tokens.py --prefs "/path/to/Plex Media Server/Preferences.xml" "Their Name"
PLEX_TOKEN=your-plex-token

# Optional: a push-monitor URL (Uptime Kuma, healthchecks.io, or similar) --
# see "Monitoring" in the README.
PUSH_URL=
